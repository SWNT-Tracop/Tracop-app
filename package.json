{
  "name": "tracop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tracop/api db:generate",
    "db:migrate": "pnpm --filter @tracop/api db:migrate",
    "build": "turbo run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "esbuild": "^0.25.0",
      "file-type": "^21.3.2",
      "handlebars": "^4.7.10",
      "multer": "^2.5.0",
      "qs": "^6.16.1",
      "vite": "^6.4.4"
    }
  }
}

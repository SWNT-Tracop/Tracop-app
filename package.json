{
  "name": "tracop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tracop/api db:generate",
    "db:migrate": "pnpm --filter @tracop/api db:migrate",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}

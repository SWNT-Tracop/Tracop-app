{
  "name": "tracop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tracop/api db:generate",
    "db:migrate": "pnpm --filter @tracop/api db:migrate",
    "db:check-migrations": "pnpm --filter @tracop/api db:check-migrations",
    "db:seed": "pnpm --filter @tracop/api db:seed",
    "identity:create-staff": "pnpm --filter @tracop/api identity:create-staff",
    "ai:eval-live": "pnpm --filter @tracop/api ai:eval-live",
    "recommendations:import-reference-prices": "pnpm --filter @tracop/api recommendations:import-reference-prices",
    "outbox:status": "pnpm --filter @tracop/api outbox:status",
    "storage:configure-lifecycle": "pnpm --filter @tracop/api storage:configure-lifecycle",
    "demo:up": "bash scripts/demo/up.sh",
    "demo:down": "bash scripts/demo/down.sh",
    "demo:check": "bash scripts/demo/check.sh",
    "demo:smoke": "pnpm --filter @tracop/api exec tsx --tsconfig test/tsconfig.worker.json scripts/demo-smoke.ts",
    "backup:restore-check": "sh scripts/backup/restore-check.sh",
    "telegram:set-webhook": "pnpm --filter @tracop/api telegram:set-webhook",
    "catalog:expire-lots": "pnpm --filter @tracop/api catalog:expire-lots",
    "catalog:backfill-changes": "pnpm --filter @tracop/api catalog:backfill-changes",
    "catalog:purge-orphan-photos": "pnpm --filter @tracop/api catalog:purge-orphan-photos",
    "storage:configure-cors": "pnpm --filter @tracop/api storage:configure-cors",
    "openapi:export": "pnpm --filter @tracop/api openapi:export",
    "openapi:check": "pnpm --filter @tracop/api openapi:check",
    "docs:check-matrix": "node scripts/check-feature-matrix.mjs",
    "build": "turbo run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "esbuild": "^0.25.0",
      "file-type": "^21.3.2",
      "handlebars": "^4.7.10",
      "js-yaml": "^5.4.1",
      "multer": "^2.5.0",
      "qs": "^6.16.1",
      "uuid": "^11.1.1",
      "vite": "^6.4.4"
    }
  }
}

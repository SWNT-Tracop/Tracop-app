S3_API_ACCESS_KEY=
S3_API_SECRET_KEY=
S3_POLICY_ACCESS_KEY=
S3_POLICY_SECRET_KEY=

# Permisos mínimos sugeridos (restringidos a S3_BUCKET):
# - S3_API_*: s3:GetObject, s3:PutObject y s3:DeleteObject sobre arn:aws:s3:::${S3_BUCKET}/*;
#   s3:ListBucket sobre arn:aws:s3:::${S3_BUCKET}, limitado a los prefijos incoming/ y photos/.
#   HeadObject se autoriza con s3:GetObject; ListObjectsV2 requiere s3:ListBucket.
# - S3_POLICY_*: solo s3:PutObject sobre arn:aws:s3:::${S3_BUCKET}/incoming/* para firmar POST.
# No usar credenciales root en producción. El permiso mínimo debe verificarse en el proveedor S3.

# Fotos del catálogo (límites por defecto; ajustables por entorno)
CATALOG_PHOTO_MAX_COUNT=5
CATALOG_PHOTO_MAX_BYTES=5242880
CATALOG_PHOTO_MAX_INPUT_PIXELS=25000000

NODE_ENV=development
# development (por defecto), demo (solo datos sintéticos, nunca con NODE_ENV=production) o production
APP_PROFILE=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Comma-separated browser origins allowed by local MinIO (server-wide CORS; default http://localhost:8081)
MINIO_CORS_ALLOWED_ORIGINS=
# Días que vive en el bucket lo subido y nunca procesado (incoming/, payment-incoming/)
INCOMING_RETENTION_DAYS=1
JWT_SECRET=
JWT_ISSUER=tracop
JWT_AUDIENCE=tracop-api
JWT_CLOCK_TOLERANCE_SECONDS=5
OTP_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET=
PRIVACY_POLICY_VERSION=v0-draft
ALLOWED_COUNTRY_CODES=57
CORS_ALLOWED_ORIGINS=
CATALOG_PRODUCT_PROPOSAL_PENDING_LIMIT=5
CATALOG_PRODUCT_PROPOSAL_RATE_LIMIT=10
CATALOG_PRODUCT_PROPOSAL_RATE_WINDOW_SECONDS=60
SUPPORTED_LOCALES=es-CO,en
TRUST_PROXY=false
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SECONDS=600
OTP_PHONE_COOLDOWN_LIMIT=1
OTP_PHONE_COOLDOWN_SECONDS=60
OTP_IP_REQUEST_LIMIT=30
OTP_IP_VERIFY_LIMIT=60
OTP_IP_WINDOW_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# PROVISIONAL: reintento de un refresh recién rotado (0 desactiva) y registros sin verificar
REFRESH_GRACE_SECONDS=30
UNVERIFIED_RETENTION_HOURS=24
JOB_EXPIRE_UNVERIFIED_CRON=23 * * * *
OTP_SENDER=console

# Mensajería
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_WEBHOOK_PROCESS_TIMEOUT_MS=5000
TELEGRAM_RATE_LIMIT_PER_SENDER=20
TELEGRAM_RATE_LIMIT_GLOBAL=300
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
CATALOG_LOT_MAX_HORIZON_DAYS=90
CATALOG_SEARCH_RADIUS_MAX_KM=500
CATALOG_SEARCH_RATE_LIMIT=60
CATALOG_SEARCH_RATE_WINDOW_SECONDS=60
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Recomendaciones y sugerencia de precios (PROVISIONALES)
RECOMMENDATIONS_REFERENCE_MAX_AGE_DAYS=30
RECOMMENDATIONS_OBSERVATION_WINDOW_DAYS=90
RECOMMENDATIONS_MIN_SAMPLE=3
RECOMMENDATIONS_MIN_OWN_OBSERVATIONS=3
RECOMMENDATIONS_MIN_OWN_PROVIDERS=2
RECOMMENDATIONS_WEIGHT_REORDER=30
RECOMMENDATIONS_WEIGHT_NEARBY=20
RECOMMENDATIONS_WEIGHT_GOOD_PRICE=25
RECOMMENDATIONS_WEIGHT_VERIFIED_PROVIDER=15
RECOMMENDATIONS_WEIGHT_FRESH=10
RECOMMENDATIONS_NEARBY_KM=50
RECOMMENDATIONS_FRESH_HOURS=48
RECOMMENDATIONS_CANDIDATE_LIMIT=200
RECOMMENDATIONS_DEFAULT_RADIUS_KM=100
RECOMMENDATIONS_ALERTS_PER_USER=10
RECOMMENDATIONS_RATE_LIMIT=60
RECOMMENDATIONS_RATE_WINDOW_SECONDS=60

# IA (asistente de lotes por Telegram). Apagado por defecto; con AI_ENABLED=true son
# obligatorios LLM_PROVIDER (anthropic | google), LLM_MODEL (sin valor por defecto), LLM_API_KEY
# y AI_CONSENT_VERSION. Con google la clave es de Google AI Studio; ver docs/adr/ADR-023.md.
# Límites y retención PROVISIONALES.
AI_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=400
AI_CONSENT_VERSION=
AI_DAILY_REQUESTS_PER_USER=30
AI_REQUESTS_PER_MINUTE=6
AI_MONTHLY_TOKEN_CAP=2000000
AI_DRAFT_TTL_MINUTES=30
AI_FINISHED_DRAFT_RETENTION_DAYS=7
AI_USAGE_RETENTION_DAYS=90
AI_INBOX_LEASE_SECONDS=60
AI_INBOX_MAX_ATTEMPTS=3
# Operación: latido del trabajador, umbral de /ready y token de /metrics (vacío = sin /metrics)
JOB_WORKER_HEARTBEAT_CRON=* * * * *
READY_WORKER_MAX_AGE_SECONDS=180
METRICS_TOKEN=
JOB_AI_INBOX_CRON=* * * * *
JOB_AI_MAINTENANCE_CRON=*/10 * * * *

# Almacenamiento
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_API_ACCESS_KEY=
S3_API_SECRET_KEY=
S3_POLICY_ACCESS_KEY=
S3_POLICY_SECRET_KEY=

# Permisos mínimos sugeridos (restringidos a S3_BUCKET):
# - S3_API_*: s3:GetObject, s3:PutObject y s3:DeleteObject sobre arn:aws:s3:::${S3_BUCKET}/*;
#   s3:ListBucket sobre arn:aws:s3:::${S3_BUCKET}, limitado a los prefijos incoming/ y photos/.
#   HeadObject se autoriza con s3:GetObject; ListObjectsV2 requiere s3:ListBucket.
# - S3_POLICY_*: solo s3:PutObject sobre arn:aws:s3:::${S3_BUCKET}/incoming/* para firmar POST.
# No usar credenciales root en producción. El permiso mínimo debe verificarse en el proveedor S3.

# Fotos del catálogo (límites por defecto; ajustables por entorno)
CATALOG_PHOTO_MAX_COUNT=5
CATALOG_PHOTO_MAX_BYTES=5242880
CATALOG_PHOTO_MAX_INPUT_PIXELS=25000000
CATALOG_PHOTO_MAX_INPUT_DIMENSION=10000
CATALOG_PHOTO_MAX_OUTPUT_DIMENSION=2048
CATALOG_PHOTO_PENDING_TTL_SECONDS=1800
CATALOG_PHOTO_UPLOAD_URL_TTL_SECONDS=900
CATALOG_PHOTO_DOWNLOAD_URL_TTL_SECONDS=300
CATALOG_PHOTO_PURGE_GRACE_SECONDS=3600
CATALOG_PHOTO_WEBP_QUALITY=80
CATALOG_PHOTO_CONCURRENCY=2
CATALOG_PHOTO_PROCESSING_LEASE_SECONDS=300
CATALOG_PHOTO_UPLOAD_RATE_LIMIT=30
CATALOG_PHOTO_UPLOAD_RATE_WINDOW_SECONDS=60

# Sync API (push body cap is route-specific; global JSON parser remains 64 KiB)
SYNC_PUSH_MAX_BODY_BYTES=262144
SYNC_PUSH_RATE_LIMIT=30
SYNC_PULL_RATE_LIMIT=120
SYNC_RATE_WINDOW_SECONDS=60
ORDER_QUOTE_TTL_HOURS=24
ORDER_RESERVATION_TTL_HOURS=24
ORDER_SUBTOTAL_ROUNDING=half_up
ORDER_COMMISSION_RATE_BPS=0
ORDER_FREIGHT_COP=0
ORDER_RATE_LIMIT=60
ORDER_RATE_WINDOW_SECONDS=60
ORDER_LOCK_TIMEOUT_MS=2000
ORDER_STATEMENT_TIMEOUT_MS=10000

# Pagos (PROVISIONAL, AGENTS §23): ventana tras un rechazo, ventana de reclamo, comprobantes
PAYMENT_REJECTION_GRACE_HOURS=4
PAYMENT_CLAIM_WINDOW_HOURS=48
PAYMENT_PROOF_MAX_BYTES=5242880
PAYMENT_PROOF_UPLOAD_URL_TTL_SECONDS=900
PAYMENT_PROOF_DOWNLOAD_URL_TTL_SECONDS=300

# Notificaciones
FCM_CREDENTIALS=
SMS_API_KEY=

# Otros
PRICE_REFERENCE_SOURCE=
MAPS_API_KEY=

# Worker (pnpm --filter @tracop/api worker): cron in UTC
# Confianza (PROVISIONAL, AGENTS §23): ventana para calificar, mínimo visible, comentario, espera tras rechazo
TRUST_RATING_WINDOW_DAYS=7
TRUST_MIN_RATINGS_VISIBLE=3
TRUST_COMMENT_MAX_LENGTH=500
TRUST_VERIFICATION_COOLDOWN_DAYS=7
TRUST_RATING_RATE_LIMIT=20
TRUST_VERIFICATION_RATE_LIMIT=5
TRUST_RATE_WINDOW_SECONDS=3600
# Logística: paquete de ubicaciones (PROVISIONAL) y límite de consultas por usuario
LOGISTICS_LOCATION_MAX_TTL_HOURS=24
LOGISTICS_LOCATION_RATE_LIMIT=30
LOGISTICS_LOCATION_RATE_WINDOW_SECONDS=60
JOB_EXPIRE_LOTS_CRON=*/5 * * * *
JOB_EXPIRE_ORDERS_CRON=*/5 * * * *
JOB_PURGE_PHOTOS_CRON=17 * * * *
JOB_RETENTION_CRON=40 4 * * *
JOB_OUTBOX_DISPATCH_CRON=* * * * *
JOB_ISSUE_SETTLEMENTS_CRON=*/15 * * * *
JOB_SEND_NOTIFICATIONS_CRON=* * * * *
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_BASE_SECONDS=30
NOTIFICATIONS_RETRY_MAX_SECONDS=3600
NOTIFICATIONS_LEASE_SECONDS=60
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
# PROVISIONAL retention (days / seconds)
OTP_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
PROCESSED_UPDATES_RETENTION_DAYS=7
RATE_LIMIT_RETENTION_SECONDS=86400

CATALOG_PHOTO_UPLOAD_URL_TTL_SECONDS=900
CATALOG_PHOTO_DOWNLOAD_URL_TTL_SECONDS=300
CATALOG_PHOTO_PURGE_GRACE_SECONDS=3600
CATALOG_PHOTO_WEBP_QUALITY=80
CATALOG_PHOTO_CONCURRENCY=2
CATALOG_PHOTO_PROCESSING_LEASE_SECONDS=300
CATALOG_PHOTO_UPLOAD_RATE_LIMIT=30
CATALOG_PHOTO_UPLOAD_RATE_WINDOW_SECONDS=60


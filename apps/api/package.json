{
  "name": "@tracop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.migrate.json",
    "lint": "eslint src test drizzle scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand --coverage",
    "db:generate": "drizzle-kit generate --custom --name=initial-schemas",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:provision-roles": "tsx scripts/provision-db-roles.ts",
    "db:seed": "tsx drizzle/seed.ts",
    "identity:create-staff": "tsx scripts/create-staff.ts",
    "showcase:seed": "tsx scripts/showcase-seed.ts",
    "showcase:purge": "tsx scripts/showcase-purge.ts",
    "ai:eval-live": "tsx scripts/ai-eval-live.ts",
    "recommendations:import-reference-prices": "tsx scripts/import-reference-prices.ts",
    "storage:configure-lifecycle": "tsx scripts/configure-storage-lifecycle.ts",
    "telegram:set-webhook": "tsx scripts/set-telegram-webhook.ts",
    "catalog:expire-lots": "tsx scripts/expire-lots.ts",
    "catalog:backfill-changes": "tsx scripts/backfill-catalog-changes.ts",
    "catalog:purge-orphan-photos": "tsx scripts/purge-orphan-photos.ts",
    "ordering:expire-reservations": "tsx scripts/expire-reservations.ts",
    "storage:configure-cors": "tsx scripts/configure-storage-cors.ts",
    "db:check-migrations": "tsx scripts/check-migration-numbering.ts",
    "openapi:export": "pnpm --filter @tracop/contracts build && OPENAPI_EXPORT=true jest --runInBand --coverage=false test/openapi-export.spec.ts",
    "openapi:check": "pnpm --filter @tracop/contracts build && OPENAPI_CHECK=true jest --runInBand --coverage=false test/openapi-export.spec.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "outbox:status": "tsx scripts/outbox-status.ts",
    "load:test": "tsx --tsconfig test/tsconfig.worker.json scripts/load-test.ts",
    "worker:start": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-presigned-post": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@tracop/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "helmet": "8.3.0",
    "jose": "^4.15.9",
    "pg": "^8.13.1",
    "pg-boss": "12.38.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "uuid": "^11.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@testcontainers/minio": "11.14.0",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

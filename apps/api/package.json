{
  "name": "@tracop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test drizzle scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand --coverage",
    "db:generate": "drizzle-kit generate --custom --name=initial-schemas",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:seed": "tsx drizzle/seed.ts",
    "identity:create-staff": "tsx scripts/create-staff.ts",
    "telegram:set-webhook": "tsx scripts/set-telegram-webhook.ts",
    "catalog:expire-lots": "tsx scripts/expire-lots.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@tracop/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "jose": "^4.15.9",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
